{
    "name": "bvnsp-signin-twilio",
    "version": "1.5.0",
    "private": true,
    "scripts": {
        "type-check": "tsc --noEmit",
        "build": "run-s type-check build_bundle",
        "build_bundle": "./node_modules/.bin/webpack",
        "prestart": "npm run build",
        "start": "twilio serverless:run",
        "debug": "npm run build && twilio serverless:run --inspect",
        "deploy": "run-s build deploy_prod_logic",
        "deploy_dev": "run-s build deploy_dev_logic",
        "deploy_dev_logic": "twilio serverless:deploy",
        "deploy_prod_logic": "twilio serverless:deploy --environment prod",
        "test": "jest",
        "test_trace_deprecation": "node --trace-deprecation ./node_modules/.bin/jest",
        "tester": "node tester.ts"
    },
    "dependencies": {
        "@twilio/runtime-handler": "2.1.0",
        "googleapis": "^173.0.0",
        "sms-segments-calculator": "^1.2.0"
    },
    "devDependencies": {
        "@swc/core": "^1.15.46",
        "@swc/jest": "^0.2.39",
        "@twilio-labs/serverless-runtime-types": "^4.0.1",
        "@types/jest": "^30.0.0",
        "dotenv": "^17.4.2",
        "fast-xml-parser": "5.10.1",
        "jest": "^30.4.2",
        "node-fetch": "^3.3.2",
        "npm-run-all": "^4.1.5",
        "swc-loader": "^0.2.7",
        "twilio-run": "^5.0.1",
        "typescript": "^7.0.2",
        "webpack": "^5.109.0",
        "webpack-cli": "^7.0.2"
    },
    "engines": {
        "node": "24"
    },
    "twilioserverless": {
        "runtime": "node24"
    },
    "overrides": {
        "cross-spawn": "^7.0.6",
        "rimraf": "^6.1.3",
        "glob": "^13.0.6"
    },
    "allowScripts": {
        "@swc/core@1.15.46": true,
        "unrs-resolver@1.12.2": true
    }
}
